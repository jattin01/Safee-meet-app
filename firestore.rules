rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Chat Rooms ──────────────────────────────────────────────────────────
    match /chat_rooms/{roomId} {
      // Only participants of a room can read it
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participants;

      // A user can create a room only if they include themselves as a participant
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants;

      // A participant can update room metadata (lastMessage, unreadCounts, etc.)
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants;

      // Messages sub-collection
      match /messages/{messageId} {
        // Read: must be a participant of the parent room
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants;

        // Write: sender must be authenticated and be the message author
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.senderId
                      && request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants;

        // Only allow updating isRead flag (not message content)
        allow update: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.participants
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      }
    }

    // ── User Profiles (Phase 2) ─────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
