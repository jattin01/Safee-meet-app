# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
# Xcode's resolved Swift Package Manager cache — regenerated on every
# build; .swiftpm/ above doesn't match this (no leading dot on the
# `swiftpm` dir here), so it kept showing up untracked in git status.
**/xcshareddata/swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Vendored third_party/didit_sdk — its own generated build/lock artifacts.
# The SDK's own pubspec.lock and its example app's are intentionally
# committed above this; these are the *nested plugin packages'* lockfiles
# (packages don't commit lockfiles, only apps/examples do) plus the
# example app's per-build ephemeral files.
third_party/didit_sdk/example/ios/Flutter/ephemeral/
third_party/didit_sdk/packages/*/pubspec.lock
